---
// test5.astro — 서울 마포구 망원동 DongPage 테스트
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import DongPage from '../components/DongPage.astro';

const region = { sidoname: '서울특별시', sigungu: '마포', dong: '공덕동', lat: 37.54961249, lon: 126.9583637, sidoSlug: 'seoul', sidoLabel: '서울특별시', accentColor: '#2563eb' };
const breadcrumbs = [
  { name: '홈', url: '/' },
  { name: '서울특별시', url: '/seoul' },
  { name: '마포구', url: '/seoul/마포구' },
  { name: '망원동', url: '/seoul/마포구/망원동' },
];
---
<BaseLayout title="[TEST5] 망원동 배관막힘 | 배관매니저 1866-2449" breadcrumbs={breadcrumbs} region="마포구 망원동" keyword="싱크대막힘">
  <Header />
  <div class="bg-yellow-100 border border-yellow-300 text-yellow-800 text-xs font-bold text-center py-2">⚠️ TEST5 — 서울 마포구 망원동</div>
  <div class="bg-gradient-to-br from-blue-900 via-blue-800 to-blue-600 text-white py-10 px-4">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs font-bold text-yellow-300 uppercase tracking-widest mb-2">서울특별시 마포구 망원동</p>
      <h1 class="text-3xl md:text-4xl font-black mb-3 leading-tight">망원동 싱크대막힘 전문 업체<br/><span class="text-yellow-300">24시간 즉시 출동</span></h1>
      <a href="tel:18662449" class="inline-flex items-center gap-2 bg-yellow-400 hover:bg-yellow-300 text-blue-900 font-black text-xl px-8 py-4 rounded-2xl shadow-lg hover:scale-105 transition-all">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
        1866-2449
      </a>
    </div>
  </div>
  <DongPage {...region} />
  <footer class="bg-gray-900 text-gray-400 text-sm text-center py-6">
    <p>© 2024 배관매니저 | <a href="tel:18662449" class="text-yellow-400 font-bold">1866-2449</a></p>
  </footer>
</BaseLayout>
