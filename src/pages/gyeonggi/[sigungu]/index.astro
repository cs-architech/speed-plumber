---
// src/pages/gyeonggi/[sigungu]/index.astro — 경기도 시군구 허브
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import ContactForm from '../../../components/ContactForm.astro';
import FAQ from '../../../components/FAQ.astro';
import { readFileSync } from 'node:fs';
import { resolve, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
import { getUniqueSigungu, getDongsBySigungu } from '../../../lib/regions';
import { SIGUNGU_TITLES, SIGUNGU_DESCS, strSeed } from '../../../data/title_templates';
import { seededPick, REVIEW_TEXTS, FAQ_TITLES } from '../../../lib/spintax';

export async function getStaticPaths() {
  const sidoname = '경기도';
  const sigungus = getUniqueSigungu(sidoname);
  return sigungus.map(sg => ({ params: { sigungu: sg } }));
}

const { sigungu } = Astro.params;
const sidoname = '경기도';
const dongs = getDongsBySigungu(sidoname, sigungu);
const kwPool = ['하수구막힘', '싱크대막힘', '배관막힘', '변기막힘', '우수관막힘'];
const seed = strSeed(sigungu);
const pageTitle = SIGUNGU_TITLES[seed % SIGUNGU_TITLES.length](sigungu, sidoname);
const pageDesc  = SIGUNGU_DESCS [seed % SIGUNGU_DESCS.length ](sigungu, sidoname);

const region  = sigungu;
const keyword = '배관막힘';
const reviewText = seededPick(seed + 4, REVIEW_TEXTS).replace(/\{region\}/g, region);
const faqTitle   = seededPick(seed + 2, FAQ_TITLES).replace('{region}', region);

function seededRand(s: number) {
  let cur = s;
  return () => { cur = (cur * 1664525 + 1013904223) & 0xffffffff; return (cur >>> 0) / 4294967295; };
}
const rand = seededRand(seed);
const faqRaw  = readFileSync(resolve(dirname(fileURLToPath(import.meta.url)), '../../../faq6000.txt'), 'utf-8');
const allFaqs: { q: string; a: string }[] = [];
for (const chunk of faqRaw.split(/\n{2,}/)) {
  const lines = chunk.split('\n');
  const qLine = lines.find(l => l.trimStart().startsWith('Q.'));
  const aLine = lines.find(l => l.trimStart().startsWith('A.'));
  if (!qLine || !aLine) continue;
  const q = qLine.replace(/^Q\.\s*/, '').trim();
  const a = aLine.replace(/^A\.\s*/, '').replace(/\]\]/g, '').trim();
  if (q.endsWith('질문') || a.startsWith('대답') || q.length < 10 || a.length < 10) continue;
  allFaqs.push({ q, a });
}
const faqCount = 8 + (seed % 3);
const pageFaqs = [...allFaqs].sort(() => rand() - 0.5).slice(0, faqCount).map(f => ({
  q: f.q.replace(/"region"/g, region).replace(/"keywords"/g, keyword),
  a: f.a.replace(/"region"/g, region).replace(/"keywords"/g, keyword),
}));

const breadcrumbs = [
  { name: '홈', url: '/' },
  { name: '경기도', url: '/gyeonggi' },
  { name: sigungu, url: `/gyeonggi/${encodeURIComponent(sigungu)}` },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${sigungu} 배관막힘 전문 업체`,
  areaServed: { '@type': 'AdministrativeArea', name: `${sidoname} ${sigungu}` },
  provider: { '@type': 'LocalBusiness', name: '배관매니저', telephone: '18662449' },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical={`https://plumbers24.netlify.app/gyeonggi/${encodeURIComponent(sigungu)}`}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <Header />

  <main class="max-w-5xl mx-auto px-4 py-10">
    <!-- 브레드크럼 -->
    <nav class="text-sm text-gray-500 mb-6 flex items-center gap-1 flex-wrap" aria-label="breadcrumb">
      <a href="/" class="hover:text-blue-600">홈</a>
      <span>›</span>
      <a href="/gyeonggi" class="hover:text-green-600">경기도</a>
      <span>›</span>
      <span class="text-gray-800 font-medium">{sigungu}</span>
    </nav>

    <div class="bg-gradient-to-r from-green-900 to-green-700 text-white rounded-2xl p-7 mb-8">
      <h1 class="text-2xl md:text-3xl font-black mb-2">{sigungu} 배관막힘 전문 업체</h1>
      <p class="text-green-100 text-sm mb-4">경기도 {sigungu} · {dongs.length}개 읍면동 서비스 · 24시간 신속출동</p>
      <a href="tel:18662449" class="inline-flex items-center gap-2 bg-yellow-400 text-green-900 font-black text-lg px-6 py-3 rounded-xl hover:bg-yellow-300 transition-colors">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
        </svg>
        1866-2449
      </a>
    </div>

    {dongs.length > 0 && (
      <section class="mb-8">
        <h2 class="text-xl font-bold text-gray-800 mb-4">{sigungu} 읍면동별 배관막힘 서비스</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
          {dongs.map((r, i) => (
            <a
              href={`/gyeonggi/${encodeURIComponent(sigungu)}/${encodeURIComponent(r.dong)}`}
              class="bg-white border border-gray-200 hover:border-green-400 hover:shadow-sm rounded-xl p-3 text-center transition-all group"
            >
              <div class="font-semibold text-gray-800 group-hover:text-green-700 text-sm">{r.dong}</div>
              <div class="text-xs text-gray-400 mt-0.5">{kwPool[i % kwPool.length]}</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="bg-green-50 rounded-2xl p-6 mb-8">
      <h2 class="text-xl font-bold text-gray-800 mb-3">{sigungu} 배관막힘 전문 해결</h2>
      <p class="text-gray-700 text-sm leading-relaxed">
        경기도 {sigungu} 지역 배관막힘 문제를 배관매니저가 신속하게 해결합니다.
        하수구막힘, 싱크대막힘, 변기막힘, 우수관막힘 등 모든 배관 문제에 24시간 대응합니다.
      </p>
    </section>

    <ContactForm region={sigungu} keyword="배관막힘" />

    <!-- 업체 작업후기 아코디언 -->
    <div class="mt-8 pb-6">
      <div class="text-center mb-3">
        <button
          id="review-toggle"
          type="button"
          class="inline-flex items-center gap-3 bg-gradient-to-r from-blue-900 to-blue-700 text-white font-bold text-base px-8 py-4 rounded-2xl shadow-lg hover:shadow-xl transition-all"
          aria-expanded="false"
          aria-controls="review-content"
        >
          <svg class="w-6 h-6 text-yellow-300" fill="currentColor" viewBox="0 0 24 24">
            <path d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"/>
          </svg>
          업체 작업후기 보기
          <span id="review-arrow" class="text-sm transition-transform duration-300">▼</span>
        </button>
      </div>
      <div
        id="review-content"
        class="hidden bg-white rounded-2xl border border-gray-100 shadow-sm p-6"
        role="region"
      >
        {reviewText.split('\n\n').filter(p => p.trim()).map(para => (
          <p class="text-gray-700 text-sm leading-relaxed mb-4 last:mb-0">{para.trim()}</p>
        ))}
      </div>
    </div>

    <!-- FAQ -->
    <div class="pb-6">
      <FAQ region={region} keyword={keyword} faqs={pageFaqs} titleOverride={faqTitle} />
    </div>
  </main>

  <footer class="bg-gray-900 text-gray-400 text-sm text-center py-6 mt-10">
    <p>© 2024 배관매니저 | Tel: <a href="tel:18662449" class="text-yellow-400 font-bold">1866-2449</a></p>
  </footer>
</BaseLayout>

<script>
  const toggle  = document.getElementById('review-toggle');
  const content = document.getElementById('review-content');
  const arrow   = document.getElementById('review-arrow');
  toggle?.addEventListener('click', () => {
    const open = !content?.classList.contains('hidden');
    content?.classList.toggle('hidden', open);
    if (arrow) arrow.style.transform = open ? '' : 'rotate(180deg)';
    toggle?.setAttribute('aria-expanded', String(!open));
  });
</script>
