---
// src/pages/gyeonggi/index.astro — 경기도 허브
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ContactForm from '../../components/ContactForm.astro';
import FAQ from '../../components/FAQ.astro';
import { readFileSync } from 'node:fs';
import { resolve, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
import { getUniqueSigungu, getDongsBySigungu } from '../../lib/regions';
import { seededPick, REVIEW_TEXTS, FAQ_TITLES } from '../../lib/spintax';

const sidoname = '경기도';
const sigungus = getUniqueSigungu(sidoname);

const region  = sidoname;
const keyword = '배관막힘';
const seed    = region.split('').reduce((acc, c) => acc + c.charCodeAt(0), 0);
const reviewText = seededPick(seed + 4, REVIEW_TEXTS).replace(/\{region\}/g, region);
const faqTitle   = seededPick(seed + 2, FAQ_TITLES).replace('{region}', region);

function seededRand(s: number) {
  let cur = s;
  return () => { cur = (cur * 1664525 + 1013904223) & 0xffffffff; return (cur >>> 0) / 4294967295; };
}
const rand = seededRand(seed);
const faqRaw  = readFileSync(resolve(dirname(fileURLToPath(import.meta.url)), '../../faq6000.txt'), 'utf-8');
const allFaqs: { q: string; a: string }[] = [];
for (const chunk of faqRaw.split(/\n{2,}/)) {
  const lines = chunk.split('\n');
  const qLine = lines.find(l => l.trimStart().startsWith('Q.'));
  const aLine = lines.find(l => l.trimStart().startsWith('A.'));
  if (!qLine || !aLine) continue;
  const q = qLine.replace(/^Q\.\s*/, '').trim();
  const a = aLine.replace(/^A\.\s*/, '').replace(/\]\]/g, '').trim();
  if (q.endsWith('질문') || a.startsWith('대답') || q.length < 10 || a.length < 10) continue;
  allFaqs.push({ q, a });
}
const faqCount = 8 + (seed % 3);
const pageFaqs = [...allFaqs].sort(() => rand() - 0.5).slice(0, faqCount).map(f => ({
  q: f.q.replace(/"region"/g, region).replace(/"keywords"/g, keyword),
  a: f.a.replace(/"region"/g, region).replace(/"keywords"/g, keyword),
}));

const breadcrumbs = [
  { name: '홈', url: '/' },
  { name: '경기도', url: '/gyeonggi' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: '경기도 배관막힘 전문 업체',
  areaServed: { '@type': 'AdministrativeArea', name: '경기도' },
  provider: { '@type': 'LocalBusiness', name: '배관매니저', telephone: '18662449' },
};
---

<BaseLayout
  title="경기도 배관막힘 전문 업체 | 배관매니저 1866-2449"
  description="경기도 전지역 배관막힘·싱크대막힘·하수구막힘 전문. 배관매니저 1866-2449. 24시간 신속출동, 당일 현장 출동."
  canonical="https://plumbers24.netlify.app/gyeonggi"
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <Header />

  <main class="max-w-5xl mx-auto px-4 py-10">
    <!-- 브레드크럼 -->
    <nav class="text-sm text-gray-500 mb-6 flex items-center gap-1" aria-label="breadcrumb">
      <a href="/" class="hover:text-blue-600">홈</a>
      <span>›</span>
      <span class="text-gray-800 font-medium">경기도</span>
    </nav>

    <!-- 히어로 -->
    <div class="bg-gradient-to-r from-green-900 to-green-700 text-white rounded-2xl p-8 mb-8 text-center">
      <h1 class="text-3xl md:text-4xl font-black mb-3">🌿 경기도 배관막힘</h1>
      <p class="text-green-100 mb-5">{sigungus.length}개 시군 전지역 · 24시간 신속출동 · 서울/경기 신속출동</p>
      <a href="tel:18662449" class="inline-flex items-center gap-2 bg-yellow-400 text-green-900 font-black text-xl px-8 py-4 rounded-xl hover:bg-yellow-300 transition-colors">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
        </svg>
        1866-2449 바로 전화
      </a>
    </div>

    <!-- 경기 시군구 그리드 -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold text-gray-800 mb-5">경기도 시군별 배관막힘 서비스</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        {sigungus.map(sg => {
          const dongs = getDongsBySigungu(sidoname, sg);
          return (
            <a
              href={`/gyeonggi/${encodeURIComponent(sg)}`}
              class="bg-white border border-gray-200 hover:border-green-400 hover:shadow-md rounded-xl p-4 transition-all group"
            >
              <div class="font-bold text-gray-800 group-hover:text-green-700 mb-1">{sg}</div>
              <div class="text-xs text-gray-400">{dongs.length}개 읍면동</div>
              <div class="text-xs text-green-500 mt-1">배관막힘 →</div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- 경기 특장점 -->
    <section class="bg-green-50 rounded-2xl p-6 mb-8">
      <h2 class="text-xl font-bold text-gray-800 mb-4">경기도 배관막힘 전문 서비스</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-700">
        <div class="flex items-start gap-2"><span class="text-green-500">✔</span> 경기 전 지역 24시간 365일 출동</div>
        <div class="flex items-start gap-2"><span class="text-green-500">✔</span> 신도시·구도심 배관 특성 완벽 이해</div>
        <div class="flex items-start gap-2"><span class="text-green-500">✔</span> 배관 내시경 무료 점검</div>
        <div class="flex items-start gap-2"><span class="text-green-500">✔</span> 아파트·빌라·단독주택 전문</div>
        <div class="flex items-start gap-2"><span class="text-green-500">✔</span> 식당·상가 배관 정기 관리</div>
        <div class="flex items-start gap-2"><span class="text-green-500">✔</span> 전문 기사 완벽 처리 보장</div>
      </div>
    </section>

    <!-- 상담 폼 -->
    <ContactForm region="경기도" keyword="배관막힘" />

    <!-- 업체 작업후기 아코디언 -->
    <div class="mt-8 pb-6">
      <div class="text-center mb-3">
        <button
          id="review-toggle"
          type="button"
          class="inline-flex items-center gap-3 bg-gradient-to-r from-blue-900 to-blue-700 text-white font-bold text-base px-8 py-4 rounded-2xl shadow-lg hover:shadow-xl transition-all"
          aria-expanded="false"
          aria-controls="review-content"
        >
          <svg class="w-6 h-6 text-yellow-300" fill="currentColor" viewBox="0 0 24 24">
            <path d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"/>
          </svg>
          업체 작업후기 보기
          <span id="review-arrow" class="text-sm transition-transform duration-300">▼</span>
        </button>
      </div>
      <div
        id="review-content"
        class="hidden bg-white rounded-2xl border border-gray-100 shadow-sm p-6"
        role="region"
      >
        {reviewText.split('\n\n').filter(p => p.trim()).map(para => (
          <p class="text-gray-700 text-sm leading-relaxed mb-4 last:mb-0">{para.trim()}</p>
        ))}
      </div>
    </div>

    <!-- FAQ -->
    <div class="pb-6">
      <FAQ region={region} keyword={keyword} faqs={pageFaqs} titleOverride={faqTitle} />
    </div>
  </main>

  <footer class="bg-gray-900 text-gray-400 text-sm text-center py-6 mt-10">
    <p>© 2024 배관매니저 | Tel: <a href="tel:18662449" class="text-yellow-400 font-bold">1866-2449</a></p>
  </footer>
</BaseLayout>

<script>
  const toggle  = document.getElementById('review-toggle');
  const content = document.getElementById('review-content');
  const arrow   = document.getElementById('review-arrow');
  toggle?.addEventListener('click', () => {
    const open = !content?.classList.contains('hidden');
    content?.classList.toggle('hidden', open);
    if (arrow) arrow.style.transform = open ? '' : 'rotate(180deg)';
    toggle?.setAttribute('aria-expanded', String(!open));
  });
</script>
