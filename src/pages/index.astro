---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQ from '../components/FAQ.astro';

// DB가 있으면 일부 지역 노출
let recentPages: any[] = [];
try {
  const db = (await import('../data/db.json')).default as any[];
  recentPages = db.slice(0, 20);
} catch {
  // db.json 없을 때 빈 배열
}
---

<BaseLayout
  title="배관매니저 | 배관막힘 전문 업체 1866-2449 24시간 신속출동"
  description="전국 배관막힘, 싱크대막힘, 우수관막힘 전문 업체 배관매니저. 24시간 신속 출동, 출장비 무료, 1866-2449"
>
  <Header />

  <main>
    <!-- 히어로 섹션 -->
    <section class="bg-gradient-to-br from-brand-800 via-brand-700 to-brand-600 text-white py-20 px-4 text-center">
      <p class="text-brand-200 text-sm font-semibold uppercase tracking-widest mb-4">24시간 신속출동</p>
      <h1 class="text-4xl md:text-5xl font-black mb-4 leading-tight">
        배관막힘<br/>
        <span class="text-accent-400">전문 업체</span> 배관매니저
      </h1>
      <p class="text-white/80 text-lg mb-8 max-w-lg mx-auto">
        배관막힘·싱크대막힘·우수관막힘 전국 출동.<br/>
        작업 전 정확한 견적, 출장비 무료.
      </p>
      <a
        href="tel:18662449"
        class="inline-flex items-center gap-3 bg-accent-500 hover:bg-accent-600 text-white font-black text-2xl px-10 py-5 rounded-2xl shadow-2xl hover:scale-105 transition-all"
      >
        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
        </svg>
        1866-2449 전화 연결
      </a>
      <p class="text-white/50 text-xs mt-4">클릭 시 바로 전화 연결됩니다</p>
    </section>

    <!-- 서비스 카드 -->
    <section class="max-w-5xl mx-auto px-4 py-14">
      <h2 class="text-2xl md:text-3xl font-bold text-center text-gray-800 mb-10">주요 서비스</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { icon: '🔧', title: '배관막힘', desc: '노후 배관, 이물질, 기름때로 인한 막힘을 고압세척 및 전문 장비로 해결합니다.' },
          { icon: '🚿', title: '싱크대막힘', desc: '주방·욕실 싱크대 배관막힘을 신속하게 뚫어드립니다. 음식물 찌꺼기, 헤어 제거.' },
          { icon: '🌧️', title: '우수관막힘', desc: '건물 외벽·지하 우수관 막힘을 전문 장비로 해결. 역류·누수 예방.' },
        ].map(s => (
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 text-center hover:shadow-md transition-shadow">
            <div class="text-4xl mb-4">{s.icon}</div>
            <h3 class="font-bold text-lg text-gray-800 mb-2">{s.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 상담 폼 -->
    <section class="max-w-2xl mx-auto px-4 pb-14">
      <ContactForm region="전국" keyword="배관막힘" />
    </section>

    <!-- 지역 링크 (거미줄 내부링크) -->
    {recentPages.length > 0 && (
      <section class="bg-gray-100 py-10 px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-xl font-bold text-gray-700 mb-5 text-center">서비스 지역 바로가기</h2>
          <div class="flex flex-wrap gap-2 justify-center">
            {recentPages.map((p: any) => (
              <a
                href={`/${p.id}`}
                class="text-xs bg-white border border-gray-200 hover:border-brand-400 hover:text-brand-600 text-gray-600 px-3 py-1.5 rounded-full transition-colors"
              >
                {p.region} {p.keyword}
              </a>
            ))}
          </div>
          <p class="text-center mt-4">
            <a href="/reviews" class="text-brand-600 hover:underline text-sm font-medium">작업 후기 보기 →</a>
          </p>
        </div>
      </section>
    )}

    <!-- FAQ -->
    <section class="max-w-3xl mx-auto px-4 py-10">
      <FAQ region="전국" keyword="배관막힘" />
    </section>
  </main>

  <footer class="bg-gray-800 text-gray-400 text-xs text-center py-6">
    <p>© 2024 배관매니저 | 배관막힘 전문 업체 | Tel: 1866-2449</p>
    <p class="mt-1">24시간 365일 신속 출동 · 출장비 무료 · 작업 전 정확한 견적</p>
  </footer>
</BaseLayout>
