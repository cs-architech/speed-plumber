---
// src/pages/contact.astro — 상담신청
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ContactForm from '../components/ContactForm.astro';

const breadcrumbs = [
  { name: '홈', url: '/' },
  { name: '상담신청', url: '/contact' },
];
---

<BaseLayout
  title="배관막힘 무료 상담신청 | 배관매니저 1866-2449"
  description="배관막힘, 싱크대막힘, 우수관막힘 무료 상담신청. 배관매니저 1866-2449. 24시간 신속출동, 현장 즉시 출동."
  canonical="https://speed-plumber.netlify.app/contact"
  breadcrumbs={breadcrumbs}
>
  <Header />

  <main class="max-w-3xl mx-auto px-4 py-10">
    <!-- 브레드크럼 -->
    <nav class="text-sm text-gray-500 mb-6 flex items-center gap-1">
      <a href="/" class="hover:text-blue-600">홈</a>
      <span>›</span>
      <span class="text-gray-800 font-medium">상담신청</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-black text-gray-900 mb-2">무료 상담신청</h1>
    <p class="text-gray-500 mb-8">배관막힘 문제를 빠르게 해결해 드립니다. 아래 양식을 작성하시면 담당자가 신속히 연락드립니다.</p>

    <!-- 전화 연결 CTA -->
    <div class="bg-gradient-to-r from-blue-900 to-blue-700 text-white rounded-2xl p-6 mb-8 text-center">
      <p class="text-blue-200 text-sm mb-2">긴급한 경우 지금 바로 전화하세요!</p>
      <a
        href="tel:18662449"
        class="inline-flex items-center gap-3 bg-yellow-400 text-blue-900 font-black text-2xl px-8 py-4 rounded-xl hover:bg-yellow-300 transition-colors shadow-lg"
      >
        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
        </svg>
        1866-2449
      </a>
      <p class="text-blue-200 text-xs mt-2">24시간 365일 · 클릭 시 바로 연결</p>
    </div>

    <!-- 상담 폼 -->
    <ContactForm region="전국" keyword="배관막힘" />

    <!-- 주의사항 -->
    <div class="mt-8 bg-gray-50 border border-gray-200 rounded-xl p-5 text-sm text-gray-600">
      <h3 class="font-semibold text-gray-700 mb-3">📋 상담 안내</h3>
      <ul class="space-y-1.5">
        <li>• 상담 신청 후 영업 담당자가 30분 이내 연락드립니다.</li>
        <li>• 긴급 출동 요청 시 전화(1866-2449)로 직접 연락주시면 빠릅니다.</li>
        <li>• 작업 전 현장 방문 후 정확한 견적을 제공합니다 (현장 즉시 출동).</li>
        <li>• 작업 완료 후 <strong>완벽한 배관 해결</strong>을 책임집니다.</li>
      </ul>
    </div>
  </main>

  <footer class="bg-gray-900 text-gray-400 text-sm text-center py-6 mt-10">
    <p>© 2024 배관매니저 | Tel: <a href="tel:18662449" class="text-yellow-400 font-bold">1866-2449</a></p>
  </footer>
</BaseLayout>
