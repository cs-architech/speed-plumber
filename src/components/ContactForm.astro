---
// src/components/ContactForm.astro
interface Props {
  region?: string;
  keyword?: string;
}
const { region = '', keyword = '' } = Astro.props;

// 제작1/3과 동일한 공유 상담접수 스크립트로 통합
const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzK8bmvdHDyfPh6MXekJ82bunwQquxPjm2R32qJcEoFxbCykqLOL0TZ1nNRNC7hwHMa/exec';
---

<section class="bg-blue-50 border border-blue-100 rounded-2xl p-6 md:p-8">
  <h2 class="text-xl md:text-2xl font-bold text-blue-900 mb-1">무료 상담 신청</h2>
  <p class="text-sm text-gray-500 mb-6">
    {region && <span class="font-medium text-blue-700">{region}</span>}
    {region && ' '}
    <span>{keyword || '배관막힘'}</span> 전문 업체가 빠르게 연락드립니다.
  </p>

  <form id="contact-form" class="space-y-4" novalidate>
    <!-- 이름 -->
    <div>
      <label for="cf-name" class="block text-sm font-medium text-gray-700 mb-1">
        성함 <span class="text-red-500">*</span>
      </label>
      <input
        id="cf-name" name="name" type="text"
        placeholder="홍길동"
        required
        autocomplete="name"
        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm bg-white"
      />
    </div>

    <!-- 전화번호 -->
    <div>
      <label for="cf-phone" class="block text-sm font-medium text-gray-700 mb-1">
        연락처 <span class="text-red-500">*</span>
      </label>
      <input
        id="cf-phone" name="phone" type="tel"
        placeholder="010-0000-0000"
        required
        autocomplete="tel"
        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm bg-white"
      />
    </div>

    <!-- 주소/위치 -->
    <div>
      <label for="cf-address" class="block text-sm font-medium text-gray-700 mb-1">
        주소 / 위치 <span class="text-red-500">*</span>
      </label>
      <input
        id="cf-address" name="address" type="text"
        placeholder="예: 서울 강남구 역삼동, 경기 수원시 영통구"
        required
        autocomplete="street-address"
        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm bg-white"
      />
    </div>

    <!-- 상담 항목 (복수 체크) -->
    <div>
      <p class="block text-sm font-medium text-gray-700 mb-2">
        상담 항목 <span class="text-gray-400">(복수 선택 가능)</span>
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
        {[
          { id: 'chk-pipe',   value: '배관막힘',   icon: '🔧' },
          { id: 'chk-sink',   value: '싱크대막힘', icon: '🚿' },
          { id: 'chk-toilet', value: '변기막힘',   icon: '🚽' },
          { id: 'chk-drain',  value: '우수관막힘', icon: '🌧️' },
          { id: 'chk-highp',  value: '고압세척',   icon: '💧' },
        ].map(item => (
          <label
            for={item.id}
            class="flex items-center gap-2 p-2.5 border border-gray-200 rounded-xl cursor-pointer hover:border-blue-400 hover:bg-blue-50 transition-colors has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 bg-white"
          >
            <input
              id={item.id}
              name="category"
              type="checkbox"
              value={item.value}
              class="w-4 h-4 text-blue-600 rounded"
            />
            <span class="text-sm text-gray-700">{item.icon} {item.value}</span>
          </label>
        ))}
          <label
            for="chk-other"
            class="flex items-center gap-2 p-2.5 border border-gray-200 rounded-xl cursor-pointer hover:border-blue-400 hover:bg-blue-50 transition-colors has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 bg-white"
          >
            <input id="chk-other" name="category" type="checkbox" value="기타" class="w-4 h-4 text-blue-600 rounded" />
            <span class="text-sm text-gray-700">📋 기타</span>
          </label>
      </div>
      <!-- 기타 텍스트 입력 (기타 체크 시 표시) -->
      <div id="other-text-wrap" class="hidden mt-2">
        <textarea
          id="cf-other-text"
          name="other_text"
          rows="2"
          placeholder="기타 문의 내용을 입력해주세요."
          class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm bg-white resize-none"
        ></textarea>
      </div>
    </div>

    <!-- 숨김 필드 -->
    <input type="hidden" name="region"   value={region} />
    <input type="hidden" name="keyword"  value={keyword} />
    <input type="hidden" name="page_url" id="cf-page-url" value="" />
    <input type="hidden" name="source"   value="contact-form" />

    <!-- 개인정보 동의 아코디언 -->
    <div class="border border-gray-200 rounded-xl overflow-hidden">
      <button
        type="button"
        id="privacy-toggle"
        class="w-full flex items-center justify-between px-4 py-3 bg-gray-50 hover:bg-gray-100 text-left text-sm text-gray-700 transition-colors"
        aria-expanded="false"
      >
        <span class="flex items-center gap-2">
          <input
            id="cf-agree"
            type="checkbox"
            name="agree"
            required
            class="w-4 h-4 text-blue-600 rounded flex-shrink-0"
            onclick="event.stopPropagation()"
          />
          <span>개인정보 수집·이용에 동의합니다 <span class="text-red-500">(필수)</span></span>
        </span>
        <span id="privacy-arrow" class="text-gray-400 text-xs transition-transform duration-200 flex-shrink-0 ml-2">▼ 내용 보기</span>
      </button>
      <div id="privacy-content" class="hidden px-4 py-3 bg-white text-xs text-gray-600 leading-relaxed border-t border-gray-100 space-y-1.5">
        <p>당사는 「개인정보보호법」, 「정보통신망 이용촉진 및 정보 보호 등에 관한 법률」에 따라 귀하의 개인정보를 다음과 같이 수집·이용하고자 합니다.</p>
        <p><strong>1. 개인정보의 수집∙이용 목적:</strong> 하수구막힘, 배관막힘, 싱크대막힘 등 상담</p>
        <p><strong>2. 수집·이용하는 개인정보의 내용:</strong> 성명, 연락처, 주소(위치)</p>
        <p><strong>3. 개인정보 보유·이용 기간:</strong> 상담종료일로부터 30일</p>
        <p><strong>4. 개인정보의 파기:</strong> 회사는 개인정보 보유 기간의 경과, 처리목적 달성 등 개인정보가 불필요하게 되었을 때에는 지체없이 해당 개인정보를 파기합니다.</p>
        <p class="text-gray-500">※ 본 동의를 거부하실 수 있으나, 거부하는 경우에는 상담이 제한될 수 있습니다.</p>
      </div>
    </div>

    <!-- 제출 버튼 -->
    <button
      type="submit"
      id="cf-submit-btn"
      class="w-full bg-blue-700 hover:bg-blue-800 text-white font-bold py-4 rounded-xl text-base transition-colors shadow-md hover:shadow-lg"
    >
      무료 상담 신청하기
    </button>
  </form>

  <!-- 결과 메시지 -->
  <div id="cf-result" class="hidden mt-4 p-4 rounded-xl text-sm font-medium"></div>
</section>

<script define:vars={{ APPS_SCRIPT_URL }}>
  // 페이지 URL 자동 입력
  document.getElementById('cf-page-url').value = window.location.href;

  // 유입경로: 최초 진입 시점의 referrer를 세션에 저장해두고, 폼 제출 시 그 값을 사용
  function getEntryReferrer() {
    const KEY = '_entry_referrer';
    let stored = sessionStorage.getItem(KEY);
    if (stored === null) {
      stored = document.referrer || '직접 접속';
      sessionStorage.setItem(KEY, stored);
    }
    return stored;
  }

  // 기타 체크박스 → 텍스트 입력 표시/숨김
  const chkOther   = document.getElementById('chk-other');
  const otherWrap  = document.getElementById('other-text-wrap');
  chkOther?.addEventListener('change', () => {
    otherWrap?.classList.toggle('hidden', !chkOther.checked);
  });

  // 개인정보 아코디언
  const privToggle  = document.getElementById('privacy-toggle');
  const privContent = document.getElementById('privacy-content');
  const privArrow   = document.getElementById('privacy-arrow');
  privToggle?.addEventListener('click', (e) => {
    if (e.target.type === 'checkbox') return;
    const open = !privContent.classList.contains('hidden');
    privContent.classList.toggle('hidden', open);
    privArrow.textContent = open ? '▼ 내용 보기' : '▲ 닫기';
    privToggle.setAttribute('aria-expanded', String(!open));
  });

  const form   = document.getElementById('contact-form');
  const result = document.getElementById('cf-result');
  const btn    = document.getElementById('cf-submit-btn');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const name    = document.getElementById('cf-name').value.trim();
    const phone   = document.getElementById('cf-phone').value.trim();
    const address = document.getElementById('cf-address').value.trim();
    const agree   = document.getElementById('cf-agree').checked;
    const cats    = [...form.querySelectorAll('input[name="category"]:checked')].map(c => c.value);

    if (!name)  { showMsg('성함을 입력해주세요.', 'error'); return; }
    if (!phone) { showMsg('연락처를 입력해주세요.', 'error'); return; }
    if (!/^0\d{1,2}[-\s]?\d{3,4}[-\s]?\d{4}$/.test(phone)) {
      showMsg('올바른 연락처 형식을 입력해주세요. (예: 010-1234-5678)', 'error'); return;
    }
    if (!address) { showMsg('주소/위치를 입력해주세요.', 'error'); return; }
    if (!cats.length) { showMsg('상담 항목을 하나 이상 선택해주세요.', 'error'); return; }
    if (!agree) { showMsg('개인정보 수집·이용 동의가 필요합니다.', 'error'); return; }

    btn.disabled = true;
    btn.textContent = '전송 중...';

    const otherText = (document.getElementById('cf-other-text')?.value || '').trim();
    const inquiryParts = [...cats];
    if (otherText) inquiryParts.push(`기타: ${otherText}`);
    const now = new Date();
    const date = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;
    const payload = {
      type:     'inquiry',
      date,
      name,
      phone,
      address,
      inquiry:  inquiryParts.join(', '),
      region:   form.querySelector('[name="region"]').value,
      keyword:  form.querySelector('[name="keyword"]').value,
      page_url: form.querySelector('#cf-page-url').value,
      source:   location.hostname,
      referrer: getEntryReferrer(),
      agree:    agree,
      timestamp: now.toISOString(),
    };

    try {
      if (APPS_SCRIPT_URL) {
        await fetch(APPS_SCRIPT_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
      }
      showMsg('✅ 상담 신청이 완료되었습니다! 빠른 시일 내 연락드리겠습니다.', 'success');
      form.reset();
    } catch {
      // no-cors 모드에서는 네트워크 계층 오류만 여기로 오며, 실제로는 접수된 경우가 대부분이라 안심 문구로 안내
      showMsg('✅ 상담 신청이 접수되었습니다. 통신 상태에 따라 다소 지연될 수 있으니, 급하시면 전화(1866-2449)로도 문의해주세요.', 'success');
      form.reset();
    } finally {
      btn.disabled = false;
      btn.textContent = '무료 상담 신청하기';
    }
  });

  function showMsg(msg, type) {
    result.textContent = msg;
    result.className = `mt-4 p-4 rounded-xl text-sm font-medium ${
      type === 'success'
        ? 'bg-green-50 text-green-700 border border-green-200'
        : 'bg-red-50 text-red-700 border border-red-200'
    }`;
    result.classList.remove('hidden');
    setTimeout(() => result.classList.add('hidden'), 7000);
  }
</script>
