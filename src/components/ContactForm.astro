---
// src/components/ContactForm.astro
// Props: region, keyword (페이지 컨텍스트 자동 삽입용)
interface Props {
  region?: string;
  keyword?: string;
}
const { region = '', keyword = '' } = Astro.props;

// 구글 앱스스크립트 URL: 배포 후 실제 URL로 교체
const APPS_SCRIPT_URL = '';
---

<section class="bg-brand-50 border border-brand-100 rounded-2xl p-6 md:p-8">
  <h2 class="text-xl md:text-2xl font-bold text-brand-800 mb-1">무료 상담 신청</h2>
  <p class="text-sm text-gray-500 mb-6">
    {region && <span class="font-medium text-brand-700">{region}</span>} {keyword} 전문 업체가 빠르게 연락드립니다.
  </p>

  <form id="contact-form" class="space-y-4" novalidate>
    <!-- 이름 -->
    <div>
      <label for="name" class="block text-sm font-medium text-gray-700 mb-1">성함 <span class="text-red-500">*</span></label>
      <input
        id="name" name="name" type="text"
        placeholder="홍길동"
        required
        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-400 text-sm"
      />
    </div>

    <!-- 전화번호 -->
    <div>
      <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">연락처 <span class="text-red-500">*</span></label>
      <input
        id="phone" name="phone" type="tel"
        placeholder="010-0000-0000"
        required
        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-400 text-sm"
      />
    </div>

    <!-- 상담 항목 -->
    <div>
      <p class="block text-sm font-medium text-gray-700 mb-2">상담 항목 <span class="text-gray-400">(복수 선택 가능)</span></p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        {[
          { id: 'chk-pipe',   value: '배관막힘',   icon: '🔧' },
          { id: 'chk-sink',   value: '싱크대막힘', icon: '🚿' },
          { id: 'chk-drain',  value: '우수관막힘', icon: '🌧️' },
        ].map(item => (
          <label for={item.id} class="flex items-center gap-3 p-3 border border-gray-200 rounded-xl cursor-pointer hover:border-brand-400 hover:bg-brand-50 transition-colors has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50">
            <input id={item.id} name="category" type="checkbox" value={item.value} class="w-4 h-4 text-brand-600 rounded" />
            <span class="text-sm font-medium text-gray-700">{item.icon} {item.value}</span>
          </label>
        ))}
      </div>
    </div>

    <!-- 숨김 필드 -->
    <input type="hidden" name="region" value={region} />
    <input type="hidden" name="keyword" value={keyword} />
    <input type="hidden" name="page_url" id="page-url" value="" />

    <!-- 제출 버튼 -->
    <button
      type="submit"
      class="w-full bg-brand-600 hover:bg-brand-700 text-white font-bold py-4 rounded-xl text-base transition-colors shadow-md hover:shadow-lg"
    >
      무료 상담 신청하기
    </button>
  </form>

  <!-- 결과 메시지 -->
  <div id="form-result" class="hidden mt-4 p-4 rounded-xl text-sm font-medium"></div>

  <!-- 개인정보 동의 -->
  <p class="mt-4 text-xs text-gray-400 text-center">
    제출 시 개인정보 수집·이용에 동의하는 것으로 간주됩니다.
  </p>
</section>

<script define:vars={{ APPS_SCRIPT_URL }}>
  document.getElementById('page-url').value = window.location.href;

  const form   = document.getElementById('contact-form');
  const result = document.getElementById('form-result');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const name  = form.querySelector('#name').value.trim();
    const phone = form.querySelector('#phone').value.trim();
    const cats  = [...form.querySelectorAll('input[name="category"]:checked')].map(c => c.value);

    if (!name)  { showMsg('성함을 입력해주세요.', 'error'); return; }
    if (!phone) { showMsg('연락처를 입력해주세요.', 'error'); return; }
    if (!cats.length) { showMsg('상담 항목을 하나 이상 선택해주세요.', 'error'); return; }

    const btn = form.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.textContent = '전송 중...';

    const payload = {
      name,
      phone,
      category: cats.join(', '),
      region:   form.querySelector('[name="region"]').value,
      keyword:  form.querySelector('[name="keyword"]').value,
      page_url: form.querySelector('#page-url').value,
      timestamp: new Date().toISOString(),
    };

    if (!APPS_SCRIPT_URL) {
      showMsg('✅ 상담 신청이 완료되었습니다! 빠른 시일 내 연락드리겠습니다.', 'success');
      form.reset();
      btn.disabled = false;
      btn.textContent = '무료 상담 신청하기';
      return;
    }

    try {
      await fetch(APPS_SCRIPT_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      showMsg('✅ 상담 신청이 완료되었습니다! 빠른 시일 내 연락드리겠습니다.', 'success');
      form.reset();
    } catch (err) {
      showMsg('전송 중 오류가 발생했습니다. 전화(1866-2449)로 문의해주세요.', 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = '무료 상담 신청하기';
    }
  });

  function showMsg(msg, type) {
    result.textContent = msg;
    result.className = `mt-4 p-4 rounded-xl text-sm font-medium ${
      type === 'success' ? 'bg-green-50 text-green-700 border border-green-200'
                        : 'bg-red-50 text-red-700 border border-red-200'
    }`;
    result.classList.remove('hidden');
    setTimeout(() => result.classList.add('hidden'), 6000);
  }
</script>
