---
// src/components/FAQ.astro
interface FaqItem { q: string; a: string; }

interface Props {
  region: string;
  keyword: string;
  faqs: FaqItem[];   // faq6000.txt에서 파싱된 10개 전달
}
const { region, keyword, faqs } = Astro.props;

// FAQPage JSON-LD (SEO 구조화 데이터)
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="py-8" itemscope itemtype="https://schema.org/FAQPage">
  <h2 class="text-2xl font-bold text-gray-800 mb-2 flex items-center gap-2">
    <span class="text-2xl">💬</span>
    자주 묻는 질문
  </h2>
  <p class="text-sm text-gray-500 mb-6">{region} {keyword} 관련 고객 FAQ</p>

  <div class="space-y-2" id="faq-list">
    {faqs.map((faq, i) => (
      <div
        class="faq-item border border-gray-200 rounded-xl overflow-hidden transition-shadow hover:shadow-sm"
        itemscope
        itemprop="mainEntity"
        itemtype="https://schema.org/Question"
      >
        <button
          class="faq-toggle w-full text-left flex items-start justify-between p-4 md:p-5 bg-white hover:bg-blue-50 transition-colors gap-3"
          data-index={i}
          aria-expanded="false"
        >
          <span class="font-semibold text-gray-800 text-sm md:text-base leading-relaxed" itemprop="name">
            <span class="inline-block text-brand-600 font-black mr-2 text-base">Q.</span>{faq.q}
          </span>
          <svg
            class="faq-icon w-5 h-5 text-gray-400 flex-shrink-0 mt-0.5 transition-transform duration-300"
            fill="none" stroke="currentColor" viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        <!-- SEO: aria-hidden 아닌 hidden → 검색엔진 크롤링 가능 -->
        <div
          class="faq-answer overflow-hidden"
          style="max-height:0;transition:max-height 0.35s ease"
          itemscope
          itemprop="acceptedAnswer"
          itemtype="https://schema.org/Answer"
        >
          <div class="px-4 md:px-5 py-4 bg-blue-50 border-t border-blue-100" itemprop="text">
            <p class="text-sm md:text-base text-gray-700 leading-relaxed">
              <span class="text-accent-500 font-black mr-2">A.</span>{faq.a}
            </p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- FAQPage JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<script>
  document.querySelectorAll('.faq-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const item   = btn.closest('.faq-item') as HTMLElement;
      const answer = item.querySelector('.faq-answer') as HTMLElement;
      const icon   = btn.querySelector('.faq-icon') as HTMLElement;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      // 다른 항목 닫기
      document.querySelectorAll('.faq-item').forEach((el: Element) => {
        const a = el.querySelector('.faq-answer') as HTMLElement;
        const b = el.querySelector('.faq-toggle') as HTMLElement;
        const ic = el.querySelector('.faq-icon') as HTMLElement;
        if (a) a.style.maxHeight = '0';
        if (b) b.setAttribute('aria-expanded', 'false');
        if (ic) ic.style.transform = '';
      });

      if (!isOpen) {
        answer.style.maxHeight = answer.scrollHeight + 'px';
        btn.setAttribute('aria-expanded', 'true');
        icon.style.transform = 'rotate(180deg)';
      }
    });
  });
</script>
