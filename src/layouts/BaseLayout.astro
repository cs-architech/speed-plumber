---
// src/layouts/BaseLayout.astro
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: object | object[];
  region?: string;
  keyword?: string;
  breadcrumbs?: { name: string; url: string }[];
}
const {
  title,
  description = '배관막힘·싱크대막힘 전문 업체 배관매니저. 24시간 신속 출동, 1866-2449',
  canonical,
  ogImage = '/og-default.jpg',
  jsonLd,
  region = '',
  keyword = '배관막힘',
  breadcrumbs,
} = Astro.props;

const siteUrl  = 'https://plumbers24.netlify.app';
const canonUrl = canonical ?? (siteUrl + Astro.url.pathname);

const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbyDVeRRffY40-PLJB3AXFWpJVqyQ9yxIJVvQj_Jxnm6x528J5HX-t6CVG_MDmfdSey0/exec';
const gaId = import.meta.env.PUBLIC_GA_ID;

// BreadcrumbList JSON-LD
const breadcrumbLd = breadcrumbs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: siteUrl + b.url,
      })),
    }
  : null;

const allLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: '배관매니저',
    url: siteUrl,
    telephone: '18662449',
    description: '전국 배관막힘, 싱크대막힘 전문 업체. 24시간 신속 출동.',
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '1866-2449',
      contactType: 'customer service',
      availableLanguage: 'Korean',
      hoursAvailable: 'Mo-Su 00:00-24:00',
    },
  },
  ...(breadcrumbLd ? [breadcrumbLd] : []),
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="format-detection" content="telephone=no" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="shortcut icon" href="/favicon.png" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={canonUrl} />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonUrl} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={`${siteUrl}${ogImage}`} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale"      content="ko_KR" />
  <meta property="og:site_name"   content="배관매니저" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={`${siteUrl}${ogImage}`} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&display=swap" rel="stylesheet" />

  <!-- JSON-LD -->
  {allLd.map(ld => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))}

  <!-- GA4 -->
  {gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
  {gaId && <script define:vars={{ gaId }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', gaId);
  </script>}
</head>
<body class="font-sans bg-gray-50 text-gray-900 antialiased">

  <!-- ══════════════════════════════════════════════════════
       상단 고정 빠른상담 바 (전화 + 접이식 미니폼)
       ══════════════════════════════════════════════════════ -->
  <div id="quick-bar" class="fixed top-0 left-0 right-0 z-[60] shadow-lg">

    <!-- 항상 보이는 상단 행 -->
    <div class="bg-gradient-to-r from-blue-900 via-blue-800 to-blue-700 text-white flex items-center justify-between px-3 py-2 gap-2">
      <!-- 전화번호 클릭 연결 -->
      <a
        href="tel:18662449"
        class="inline-flex items-center gap-1.5 text-yellow-300 font-black text-base md:text-lg hover:text-yellow-200 transition-colors flex-shrink-0"
        aria-label="전화 연결 1866-2449"
      >
        <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
        </svg>
        1866-2449
      </a>

      <span class="text-white/60 text-xs hidden md:block flex-1 text-center">24시간 365일 · 서울/경기 신속출동 · 지금 바로 연결</span>

      <!-- 빠른 상담신청 토글 버튼 -->
      <button
        id="quick-form-toggle"
        type="button"
        class="flex items-center gap-1.5 bg-yellow-400 hover:bg-yellow-300 text-blue-900 font-bold text-xs px-3 py-1.5 rounded-full transition-colors whitespace-nowrap flex-shrink-0"
        aria-expanded="false"
        aria-controls="quick-form-panel"
      >
        빠른 상담신청
        <span id="quick-form-arrow" class="inline-block transition-transform duration-200 text-[10px]">▼</span>
      </button>
    </div>

    <!-- 펼쳐지는 미니 폼 패널 -->
    <div
      id="quick-form-panel"
      class="hidden bg-blue-950 border-t border-blue-700 px-4 py-3"
      role="region"
      aria-label="빠른 상담 신청 폼"
    >
      <form id="quick-form" class="space-y-2" novalidate>
        <!-- 이름 + 연락처 한 줄 -->
        <div class="flex flex-wrap gap-2">
          <input
            type="text"
            name="qname"
            id="q-name"
            placeholder="이름 *"
            autocomplete="name"
            class="flex-1 min-w-[90px] px-3 py-2 rounded-lg text-sm text-gray-900 bg-white focus:outline-none focus:ring-2 focus:ring-yellow-400"
          />
          <input
            type="tel"
            name="qphone"
            id="q-phone"
            placeholder="연락처 * 010-0000-0000"
            autocomplete="tel"
            class="flex-1 min-w-[160px] px-3 py-2 rounded-lg text-sm text-gray-900 bg-white focus:outline-none focus:ring-2 focus:ring-yellow-400"
          />
        </div>

        <!-- 서비스 선택 (라디오) -->
        <div class="flex flex-wrap gap-x-4 gap-y-1">
          {['하수구막힘', '변기막힘', '배관막힘', '기타'].map((s, i) => (
            <label class="flex items-center gap-1.5 text-xs text-white cursor-pointer">
              <input
                type="radio"
                name="qservice"
                value={s}
                checked={i === 0}
                class="w-3.5 h-3.5 accent-yellow-400"
              />
              {s}
            </label>
          ))}
        </div>

        <!-- 개인정보 동의 + 접수 버튼 한 줄 -->
        <div class="flex flex-wrap items-center gap-3">
          <label class="flex items-center gap-1.5 text-xs text-white/80 cursor-pointer flex-1 min-w-[200px]">
            <input id="q-agree" type="checkbox" class="w-3.5 h-3.5 accent-yellow-400 flex-shrink-0" />
            <span>개인정보 수집·이용에 동의합니다 <span class="text-red-400">(필수)</span></span>
          </label>
          <button
            type="submit"
            id="q-submit-btn"
            class="bg-yellow-400 hover:bg-yellow-300 text-blue-900 font-black text-sm px-5 py-2 rounded-lg transition-colors whitespace-nowrap"
          >
            접수하기
          </button>
        </div>

        <!-- 결과 메시지 -->
        <div id="quick-result" class="hidden text-xs font-medium py-1.5 px-3 rounded-lg"></div>
      </form>
    </div>
  </div>

  <!-- 상단 바 높이만큼 여백 (collapsed 기준 h-10) -->
  <div id="quick-bar-spacer" class="h-10"></div>

  <slot />

  <script define:vars={{ APPS_SCRIPT_URL }}>
    const toggle  = document.getElementById('quick-form-toggle');
    const panel   = document.getElementById('quick-form-panel');
    const arrow   = document.getElementById('quick-form-arrow');
    const spacer  = document.getElementById('quick-bar-spacer');
    const form    = document.getElementById('quick-form');
    const result  = document.getElementById('quick-result');
    const bar     = document.getElementById('quick-bar');

    function updateSpacer() {
      if (spacer && bar) spacer.style.height = bar.offsetHeight + 'px';
    }

    toggle?.addEventListener('click', () => {
      const isOpen = !panel?.classList.contains('hidden');
      panel?.classList.toggle('hidden', isOpen);
      if (arrow) arrow.style.transform = isOpen ? '' : 'rotate(180deg)';
      toggle?.setAttribute('aria-expanded', String(!isOpen));
      setTimeout(updateSpacer, 10);
    });

    window.addEventListener('resize', updateSpacer);
    updateSpacer();

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const nameVal  = (document.getElementById('q-name')).value.trim();
      const phoneVal = (document.getElementById('q-phone')).value.trim();
      const service  = form.querySelector('input[name="qservice"]:checked')?.value ?? '기타';
      const agreed   = (document.getElementById('q-agree')).checked;

      if (!nameVal)  { showQ('이름을 입력해주세요.', 'error'); return; }
      if (!phoneVal) { showQ('연락처를 입력해주세요.', 'error'); return; }
      if (!/^0\d{1,2}[-\s]?\d{3,4}[-\s]?\d{4}$/.test(phoneVal)) {
        showQ('올바른 연락처 형식을 입력해주세요. (예: 010-1234-5678)', 'error'); return;
      }
      if (!agreed) { showQ('개인정보 수집·이용에 동의해주세요.', 'error'); return; }

      const btn = document.getElementById('q-submit-btn');
      btn.disabled = true;
      btn.textContent = '전송 중...';

      const _now = new Date();
      const _date = `${_now.getFullYear()}-${String(_now.getMonth()+1).padStart(2,'0')}-${String(_now.getDate()).padStart(2,'0')}`;
      const payload = {
        type:     'inquiry',
        date:     _date,
        name:     nameVal,
        phone:    phoneVal,
        inquiry:  service,
        page_url: window.location.href,
        source:   'quick-bar',
        timestamp: _now.toISOString(),
      };

      try {
        if (APPS_SCRIPT_URL) {
          await fetch(APPS_SCRIPT_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
        }
        showQ('✅ 접수 완료! 빠른 시일 내 연락드리겠습니다.', 'success');
        form.reset();
        form.querySelector('input[name="qservice"]').checked = true;
      } catch {
        showQ('오류가 발생했습니다. 전화(1866-2449)로 문의해주세요.', 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = '접수하기';
        setTimeout(updateSpacer, 50);
      }
    });

    // ── 일 방문자 카운터 (하루 1회, localStorage 기반) ──────────────
    (function trackVisit() {
      try {
        const APPS_URL = 'https://script.google.com/macros/s/AKfycbyDVeRRffY40-PLJB3AXFWpJVqyQ9yxIJVvQj_Jxnm6x528J5HX-t6CVG_MDmfdSey0/exec';
        const today = new Date().toISOString().slice(0, 10);
        const key   = 'pv_counted_' + today;
        if (localStorage.getItem(key)) return; // 오늘 이미 카운트됨
        localStorage.setItem(key, '1');
        fetch(APPS_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: 'pageview',
            date: today,
            page_url: window.location.href,
            timestamp: new Date().toISOString(),
          }),
        }).catch(() => {});
      } catch (_) {}
    })();

    function showQ(msg, type) {
      result.textContent = msg;
      result.className = `text-xs font-medium py-1.5 px-3 rounded-lg ${
        type === 'success'
          ? 'bg-green-800 text-green-200 border border-green-600'
          : 'bg-red-900 text-red-200 border border-red-700'
      }`;
      result.classList.remove('hidden');
      setTimeout(() => { result.classList.add('hidden'); updateSpacer(); }, 5000);
    }
  </script>
</body>
</html>
